{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sheep-a-sheep",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // 部署到自定义域名时取消注释并替换:
  // "routes": [
  //   { "pattern": "sheep.game.foxtang.com", "custom_domain": true }
  // ]
}
